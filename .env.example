# Server-only configuration
DATABASE_URL=
# Generate at least 32 random characters; required for signed session cookies.
SESSION_SECRET=
OPENAI_API_KEY=
AI_MODEL=
GROQ_API_KEY=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Keep the upstream separate when FUJI_RPC_URL points the app at the local fork.
FUJI_FORK_UPSTREAM_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_FORK_PORT=8545
# Optional: pin a Fuji block for repeatable remote state and archive-capable RPCs.
FUJI_FORK_BLOCK_NUMBER=
# Use this to run the existing portfolio adapter against the local fork.
FUJI_FORK_RPC_URL=http://127.0.0.1:8545
# Local-only helper amount; run `pnpm fork:fund-usdc` after starting/resetting the fork.
FUJI_FORK_USDC_AMOUNT=100
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-pro
# Optional for local debugging; the adapter routes models to the correct OpenCode Go path.
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENDEX_API_KEY=
FUJI_ERC20_TOKENS_JSON=
POSTHOG_API_KEY=
SENTRY_DSN=

# Browser-safe configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC_SUBSCRIPTIONS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_LOCALNET_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_SOLANA_LOCALNET_RPC_SUBSCRIPTIONS_URL=ws://127.0.0.1:8900
# JAW smart-account execution. The browser key identifies the app to JAW; it is
# intentionally public. Keep the delegated signer private and server-only.
NEXT_PUBLIC_JAW_API_KEY=
JAW_API_KEY=
JAW_DELEGATE_PRIVATE_KEY=
# Optional browser-side copy of the address derived from JAW_DELEGATE_PRIVATE_KEY.
NEXT_PUBLIC_JAW_DELEGATE_ADDRESS=
# If browser variables are omitted, WealthBuilder serves the JAW integration key
# and derived delegate address from /api/jaw/config. Never expose the private key.
# Localhost only: JAW's official Account.fromLocalAccount root signer.
JAW_DEV_HEADLESS=false
JAW_DEV_PRIVATE_KEY=
ZERODEV_RPC=
ZERODEV_OWNER_PRIVATE_KEY=
ZERODEV_AGENT_PRIVATE_KEY=
