# Server-only configuration
DATABASE_URL=
# Generate at least 32 random characters; required for signed session cookies.
SESSION_SECRET=
OPENAI_API_KEY=
AI_MODEL=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Keep the upstream separate when FUJI_RPC_URL points the app at the local fork.
FUJI_FORK_UPSTREAM_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_FORK_PORT=8545
# Optional: pin a Fuji block for repeatable remote state and archive-capable RPCs.
FUJI_FORK_BLOCK_NUMBER=
# Use this to run the existing portfolio adapter against the local fork.
FUJI_FORK_RPC_URL=http://127.0.0.1:8545
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-pro
# Optional for local debugging; the adapter routes models to the correct OpenCode Go path.
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
FUJI_ERC20_TOKENS_JSON=
POSTHOG_API_KEY=
SENTRY_DSN=

# Browser-safe configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
