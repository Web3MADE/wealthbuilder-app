{
  "name": "wealthbuilder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fork": "pnpm fork:fund-usdc && RUN_FUJI_FORK_SMOKE=1 vitest run tests/fuji-fork.smoke.test.ts",
    "fork:start": "node scripts/fuji-fork.mjs start",
    "fork:reset": "node scripts/fuji-fork.mjs reset",
    "fork:fund-usdc": "node scripts/fund-local-fuji-usdc.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@jaw.id/core": "^1.4.3",
    "@jaw.id/wagmi": "^1.1.3",
    "@tanstack/react-query": "^5.74.9",
    "@wagmi/connectors": "8.2.0",
    "@wagmi/core": "3.6.5",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/permissions": "^5.6.3",
    "@zerodev/sdk": "^5.5.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.511.0",
    "next": "^15.3.1",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "tailwindcss": "^4.1.5",
    "viem": "^2.28.0",
    "wagmi": "^3.7.7",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  }
}
